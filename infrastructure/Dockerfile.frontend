# syntax=docker/dockerfile:1

# --- Stage 1: Builder ---
FROM node:18-alpine AS builder

WORKDIR /app

COPY package*.json ./
# Install dependencies (using npm install for initial bootstrap as no lockfile exists yet)
RUN npm install --ignore-scripts

COPY . .
RUN npm run build

# --- Stage 2: Runner ---
FROM nginx:alpine-slim

# Install curl for healthcheck (optional, can use wget present in alpine)
# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom secure nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy static assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Security Hardening:
# 1. Change ownership of required directories to non-root nginx user
RUN chown -R nginx:nginx /var/cache/nginx /var/run /var/log/nginx /usr/share/nginx/html

# 2. Switch to non-root user
USER nginx

# 3. Healthcheck
HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget --quiet --tries=1 --spider http://localhost:80/ || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
