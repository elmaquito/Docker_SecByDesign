# syntax=docker/dockerfile:1

# --- Stage 1: Builder ---
FROM node:20-bullseye AS builder

WORKDIR /app

# Install build tools for native modules (argon2)
# node:18-bullseye includes python3, make, g++ but run update to be safe and ensure deps
RUN apt-get update && apt-get install -y python3 make g++

# Copy package files first for caching
COPY package*.json ./

# Install dependencies (using npm install for initial bootstrap as no lockfile exists yet)
# In production with lockfile, use: RUN npm ci --ignore-scripts
RUN npm install --build-from-source=argon2 || { echo "npm install failed"; cat /root/.npm/_logs/*-debug.log; exit 1; }

# Copy source code
COPY . .

# Build the application (TypeScript -> JS)
RUN npm run build

# --- Stage 2: Runner (Secure Production Image) ---
# Use Distroless for minimal attack surface (no shell, no package manager)
# Or Alpine if debugging is strictly necessary (but Distroless is safer)
# FROM gcr.io/distroless/nodejs20-debian11 AS runner
FROM node:20-alpine AS runner
RUN apk add --no-cache curl

WORKDIR /app

# Set production environment
ENV NODE_ENV=production

# Copy built artifacts from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules

# Pour éviter l'erreur de build sur la syntaxe shell, on copie simplement tous les .env existants
COPY --from=builder /app/.env* ./

# Run as non-root user
USER 65532:65532

# Healthcheck
HEALTHCHECK --interval=30s --timeout=3s CMD curl -sf http://localhost:3000/health || exit 1

EXPOSE 3000

# Start the application
CMD ["npm", "start"]

EXPOSE 3000

# Start the application
CMD ["npm", "start"]
