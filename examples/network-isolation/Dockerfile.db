# Exemple: Isolation réseau - Service Base de données
# Ce service n'a accès qu'au réseau backend (isolation maximale)

FROM python:3.11-slim

RUN groupadd --gid 1000 appgroup && \
    useradd --uid 1000 --gid appgroup --shell /bin/bash --create-home appuser

WORKDIR /app

COPY --chown=appuser:appgroup db.py .

USER appuser

EXPOSE 8082

CMD ["python", "db.py"]
